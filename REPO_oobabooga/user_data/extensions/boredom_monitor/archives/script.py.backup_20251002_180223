            "method": "javascript_dom"
        })

        # This method requires browser context - simulate via Gradio's internal JS
        # In a real browser environment, this would execute:
        js_code = f"""
        function injectGradioChat(message) {{
            const gradioApp = document.getElementsByTagName('gradio-app')[0];
            if (!gradioApp?.shadowRoot) return false;

            const selectors = ['textarea', '#chatbot textarea', '.chat-input textarea'];
            for (let selector of selectors) {{
                const input = gradioApp.shadowRoot.querySelector(selector);
                if (input) {{
                    input.value = "{message}";
                    input.dispatchEvent(new Event('input', {{ bubbles: true }}));

                    const submitBtn = gradioApp.shadowRoot.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.click();
                    return true;
