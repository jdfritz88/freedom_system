            "injection_number": injection_count,
            "results": results
        })
        return success_found

    log_enhanced("All 10 injection methods failed", "ERROR", "inject_message_multi", {
        "injection_attempt": injection_count,
        "methods_tried": len(methods)
    })
    return False

